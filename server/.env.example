# development | test | production
APP_ENV=development

# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://kawika:CHANGE_ME@127.0.0.1:5432/kawika
# Separate database used by pytest and the Playwright end-to-end suite
TEST_DATABASE_URL=postgresql+psycopg://kawika:CHANGE_ME@127.0.0.1:5432/kawika_test

# Comma-separated list of frontend origins allowed to call the API
CLIENT_ORIGINS=http://localhost:5173
# Hostnames this API answers to (Host header allowlist)
ALLOWED_HOSTS=localhost,127.0.0.1

# Signs CSRF tokens. Required (32+ chars) in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Secure cookies need HTTPS. Set to false only for local plain-HTTP development.
COOKIE_SECURE=false
# Screen new passwords against Have I Been Pwned (k-anonymity, no password leaves the server)
BREACH_CHECK_ENABLED=true

# Rate limits (attempts per window)
LOGIN_IP_LIMIT=30
LOGIN_ACCOUNT_LIMIT=5
REGISTER_IP_LIMIT=5
